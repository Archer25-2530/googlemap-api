GOOGLE_MAPS_API_KEY=your_key_here
# Dedicated shared secret for the GET /api/drive-time endpoint used by
# clients that can't do OAuth (e.g. tinyNature). Unrelated to the Google
# key above — rotate independently, never reuse GOOGLE_MAPS_API_KEY here.
TINYNATURE_API_KEY=your_tinynature_secret_here
PORT=3000
# Sets the container's local timezone so "now" departure_time and computed
# arrival_time in get_route_eta reflect Indiana local time, not UTC.
TZ=America/Indiana/Indianapolis
